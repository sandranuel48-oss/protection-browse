# Environment Configuration Template for protection-browse

# Blockchain/Wallet Operations
# Replace 'YOUR_INFURA_PROJECT_ID_HERE' with your actual Infura project ID
INFURA_PROJECT_ID=YOUR_INFURA_PROJECT_ID_HERE

# Private Key for wallet operations
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# Configuration for the Puppeteer scraper
# Replace 'https://example.com' with the target URL you want to scrape
TARGET_URL=https://example.com

# User-Agent string for the Puppeteer scraper
USER_AGENT='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3'

# Automation & Propagation
# Replace 'YOUR_DISCORD_BOT_TOKEN_HERE' with your actual Discord bot token
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Guild ID for the Discord bot to interact with
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID_HERE

# Proxy rotation list format for the Python automation script
# Each proxy should be on a new line, e.g., 'http://proxy1.example.com:8080'
PROXY_LIST=#
# http://proxy1.example.com:8080
# http://proxy2.example.com:8081
# http://proxy3.example.com:8082
